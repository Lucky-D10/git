# Optional /etc/focus/ai.env. Keep the real file outside the repository, mode 0600.
# Disabled means fully local statistics and template reports, without API requests.
FOCUS_AI_PROVIDER=disabled
# Set to a model ID available in your DeepSeek account when enabling the provider.
FOCUS_AI_MODEL=
DEEPSEEK_API_KEY=
FOCUS_AI_TIMEOUT=15
FOCUS_AI_ALLOW_SIMULATION=0
# Set a private staff passphrase of at least six characters to view previous visits.
FOCUS_STAFF_PIN=
